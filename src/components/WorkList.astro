---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<ul class="work-list">
  {
    entries.map((entry) => (
      <li>
        <a href={`/work/${entry.id}/`} class="work-item">
          <div class="work-meta">
            <span class="meta">{entry.data.company}</span>
            <span class="meta">{entry.data.period}</span>
          </div>
          <h3>{entry.data.title}</h3>
          <p class="work-line">{entry.data.oneLiner}</p>
          <span class="work-result">
            {entry.data.metrics[0].value} · {entry.data.metrics[0].label}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .work-list li {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }

  .work-item {
    display: block;
    padding: 1.75rem 0;
    text-decoration: none;
  }

  .work-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .work-item h3 {
    max-width: var(--measure);
    margin-bottom: 0.4rem;
    transition: color 120ms ease;
  }

  .work-item:hover h3 {
    color: var(--accent);
  }

  .work-line {
    color: var(--text-secondary);
    font-size: var(--size-small);
    margin-bottom: 0.6rem;
  }

  .work-result {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--text-muted);
    font-feature-settings: 'tnum';
  }
</style>
