---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';

const entries = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base
  title="Sara Johnson — Senior Technical Product Manager"
  description="Senior technical product manager. Customer onboarding, data migration, APIs and developer experience. Thirteen years in software, eleven of them writing production code."
>
  <header class="intro">
    <h1>I own customer onboarding end to end.</h1>
    <p class="lede">
      The data pipelines that convert and validate customer files, the internal tooling a
      professional services team runs on, and the self-service surfaces that eventually replace
      both. Thirteen years in software, eleven of them writing production code before I moved into
      product. I build the pilot myself when that's the fastest way to find out whether an idea
      works.
    </p>
  </header>

  <section class="section" aria-labelledby="work-heading">
    <div class="section-head">
      <span class="meta">01</span>
      <h2 id="work-heading">Selected work</h2>
    </div>
    <WorkList entries={entries} />
    <p class="more"><a href="/work/">All work →</a></p>
  </section>

  <section class="section" aria-labelledby="eng-heading">
    <div class="section-head">
      <span class="meta">02</span>
      <h2 id="eng-heading">The engineering years</h2>
    </div>
    <p>
      Six and a half years at Aon Hewitt converting client data into production-ready systems on
      deadline. Three at Charter Software building dealer-management integrations. Sixteen months
      at Nymbl shipping a 0→1 health feature. The problem I own now is the one I spent eleven years
      solving from the other side of it.
    </p>
    <p><a href="/engineering/">What the engineering years bought →</a></p>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="section-head">
      <span class="meta">03</span>
      <h2 id="contact-heading">Contact</h2>
    </div>
    <p>
      <a href="mailto:sarapriceprogrammer@gmail.com">sarapriceprogrammer@gmail.com</a> ·
      <a href="https://www.linkedin.com/in/programmer-sara/">LinkedIn</a> ·
      <a href="https://github.com/sarakjohnson">GitHub</a>
    </p>
    <p class="looking">TODO — one line on what you're looking for right now.</p>
  </section>
</Base>

<style>
  .intro {
    max-width: var(--measure);
    margin-bottom: var(--section-gap);
  }

  .intro h1 {
    margin-bottom: 1.25rem;
  }

  .section {
    margin-bottom: var(--section-gap);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .more {
    margin-top: 1.5rem;
    font-size: var(--size-small);
  }

  .looking {
    color: var(--text-muted);
  }
</style>
